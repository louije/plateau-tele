{
  "name": "plateau-tele",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun --watch server/index.ts\" \"bun esbuild.config.js --watch\"",
    "build:client": "bun esbuild.config.js",
    "build": "bun run build:client",
    "start": "bun server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
